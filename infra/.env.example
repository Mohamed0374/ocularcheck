# ==========================================================================
# OcularCheck AI — local development environment (Phase 1 · P1-T5)
#
# Copy the file, then replace every placeholder before first run:
#   copy infra\.env.example infra\.env
#
# Every value below is an obviously fake placeholder — passwords, users, db
# and bucket names are NOT usable defaults. infra/.env is git-ignored;
# never commit it.
# ==========================================================================

# --- Postgres (PostGIS) -----------------------------------------------------
# User / database names must use underscores (not hyphens): the official
# postgres image entrypoint builds unquoted SQL identifiers from them.
POSTGRES_USER=change_me_postgres_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=change_me_postgres_db
# Must match the three values above; host is the compose service name.
DATABASE_URL=postgresql://change_me_postgres_user:change-me-postgres-password@postgres:5432/change_me_postgres_db

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password
# Must match REDIS_PASSWORD above; host is the compose service name.
REDIS_URL=redis://:change-me-redis-password@redis:6379

# --- MinIO (S3-compatible object storage) --------------------------------------
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=change-me-minio-root-password
# The "minio-init" service creates this bucket; it stays PRIVATE (no public access).
# S3 bucket names allow only lowercase letters, digits and hyphens.
MINIO_BUCKET=change-me-dev-bucket
# Service-to-service URL inside the compose network (S3 API port).
S3_ENDPOINT=http://minio:9000

# --- Service URLs (service-to-service, inside the compose network) --------------
AI_SERVICE_URL=http://ai-service:8000

# --- Host ports (published on 127.0.0.1 only) -----------------------------------
# BACKEND_PORT is also the container's listen port (backend reads PORT).
BACKEND_PORT=3000
# Host port for the ai-service; the container always listens on 8000.
AI_SERVICE_PORT=8000
