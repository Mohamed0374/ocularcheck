// OcularCheck AI — data model (Phase 2 · P2-T2).
//
// Conventions:
// - snake_case table and column names via @@map/@map; plural table names.
// - UUID primary keys (v7, database-side generated function is not used;
//   uuid(7) is generated by Prisma/insert-side, sequence-free ordering).
// - All timestamps are timestamptz(6); audit timestamps are mandatory;
//   dates of birth are plain @db.Date (no time/timezone semantics).
// - Schema-level CHECK constraints that Prisma cannot express live in the
//   first migration (prisma/migrations/…_init_users_profiles). Migrations
//   are append-only after they are applied anywhere.
//
// IMPORTANT (service-layer rule, see docs/database.md and ADR 0003):
// "a doctor_profile may only reference a user whose role is doctor" cannot
// be expressed as a simple PostgreSQL CHECK constraint (no cross-table
// column references). It is enforced in the service layer from Phase 3 on.

generator client {
  provider = "prisma-client"
  // The generated client is treated as build-time source code inside the
  // backend source tree: tsc compiles it with `nest build`; it is never
  // committed (backend/src/generated is in .gitignore).
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No url here: in Prisma ORM 7 the connection URL is provided by
  // prisma.config.ts (datasource.url), so `prisma generate` can run offline
  // in CI (no DATABASE_URL, no .env, no database).
}

// ---------------------------------------------------------------------------
// Enums — values are stored lowercase in the database via @map.
// ---------------------------------------------------------------------------

enum Role {
  PATIENT @map("patient")
  DOCTOR  @map("doctor")
}

enum Locale {
  EN @map("en")
  AR @map("ar")
}

enum Sex {
  MALE   @map("male")
  FEMALE @map("female")
  OTHER  @map("other")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Account holder shared by both roles. Authentication arrives in Phase 3;
/// passwordHash is written by the auth service (argon2id) and never read
/// back by application screens.
model User {
  /// UUIDv7 primary key (insert-time generated, sortable).
  id String @id @default(uuid(7)) @db.Uuid

  /// Database CHECK "email = lower(email)" lives in the migration SQL
  /// (Prisma schemas do not support column CHECK constraints); uniqueness
  /// is enforced at database level for concurrent-safe signup (Phase 3).
  email String @unique

  /// Argon2id hash once P3-T1 lands. The seed writes an invalid placeholder
  /// so seeded accounts can never authenticate.
  passwordHash String @map("password_hash")
  role         Role

  /// Display name; non-empty after trim is enforced by a migration CHECK.
  fullName String @map("full_name")

  /// Locale of UI / generated documents.
  locale Locale @default(EN)

  /// Soft-delete / anonymisation marker. Nullable by design: non-null
  /// excludes the account from normal queries without destroying the row.
  deletedAt DateTime? @db.Timestamptz(6) @map("deleted_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  // 1:1 profiles; deleting the user removes its profile data (Cascade).
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?

  // Doctor-role lists (e.g. finding verified doctors) will filter heavily
  // on role; the composite access patterns of Phase 3 rely on this index.
  @@index([role])
  @@map("users")
}

/// Patient questionnaire data used by the screening workflow. 1:1 with User
/// via shared primary key; deleting a user cascades here (account deletion
/// removes profile data - see the foreign key clauses in the migration).
model PatientProfile {
  userId String @id @db.Uuid @map("user_id")

  dateOfBirth DateTime? @db.Date @map("date_of_birth")
  sex         Sex?

  // Risk factors that drive screening cadence and report context.
  hasDiabetes           Boolean @default(false) @map("has_diabetes")
  hasHypertension       Boolean @default(false) @map("has_hypertension")
  // Glaucoma family history is a primary risk factor for retinal disease.
  familyHistoryGlaucoma Boolean @default(false) @map("family_history_glaucoma")

  // Free-text notes; the maximum length (2000 chars) is enforced by the
  // application layer (DTO validation in Phase 3), not by the database.
  notes String?

  // When the patient accepted the medical disclaimer / data-processing
  // consent; null until the consent flow (Phase 3+) is completed.
  consentAt DateTime? @db.Timestamptz(6) @map("consent_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patient_profiles")
}

/// Doctor metadata. licenseNumber is unique at database level. Clinic
/// relations are deliberately deferred to Phase 10.
model DoctorProfile {
  userId String @id @db.Uuid @map("user_id")

  licenseNumber String @unique @map("license_number")
  // Denormalized display field (e.g. "Ophthalmology", or "Ophthalmology —
  // Retina"); refinement is out of scope for this phase.
  specialty String

  // Admin verification timestamp; null = pending review.
  verifiedAt DateTime? @db.Timestamptz(6) @map("verified_at")

  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctor_profiles")
}
