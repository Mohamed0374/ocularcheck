# Development image for the OcularCheck AI backend (Phase 1 · P1-T5).
# The production image is built in Phase 16 (P16-T2).
# Debian (glibc) basis — not alpine — because the Prisma query engine used in
# later phases needs OpenSSL with glibc; openssl itself is installed for that.
FROM node:26.12.1-bookworm-slim

# curl: used by the docker-compose healthcheck. Minimal, dev-only.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency install in its own layer: editing source does not re-run npm ci.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && npm cache clean --force \
    && chown -R node:node /app

# Run as the non-root user that ships with the node image. No secrets are baked
# into this image — all runtime configuration is injected via compose env.
USER node

CMD ["npm", "run", "start:dev"]
