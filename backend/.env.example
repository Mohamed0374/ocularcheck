# ==========================================================================
# OcularCheck AI — backend local development environment (Phase 2 · P2-T1)
#
# Copy the file, then replace every placeholder before first run:
#   copy backend\.env.example backend\.env
#
# Every value below is an obviously fake placeholder — NOT usable defaults.
# Real values go in backend/.env, which is git-ignored; never commit it.
# Variable names mirror infra/.env.example and infra/docker-compose.yml.
# Validation is fail-fast: missing required variables crash startup with
# their names (never their values).
# ==========================================================================

# --- App ---------------------------------------------------------------------
# NODE_ENV is required, one of: development | test | production.
NODE_ENV=development
# PORT / HOST are optional (defaults: 3000 / 0.0.0.0).
PORT=3000
HOST=0.0.0.0
# Optional pino log level; one of fatal | error | warn | info | debug | trace | silent.
# Default: info. The test environment may set "silent".
LOG_LEVEL=info

# --- Database (PostgreSQL/PostGIS) --------------------------------------------
# Required. Must be a postgres:// or postgresql:// URL.
DATABASE_URL=postgresql://change_me_postgres_user:change-me-postgres-password@localhost:5432/change_me_postgres_db

# --- Redis ----------------------------------------------------------------------
# Required. Must be a redis:// or rediss:// URL.
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# --- Storage (S3-compatible) ------------------------------------------------------
# Required. http(s) URL, e.g. local MinIO from the docker stack.
S3_ENDPOINT=http://localhost:9000
# Required. Bucket created by infra "minio-init"; lowercase/digits/hyphens only.
MINIO_BUCKET=change-me-dev-bucket
# Optional; defaults to us-east-1.
S3_REGION=us-east-1
# Required. Local dev reuses the MinIO root credentials from the docker stack.
# TODO(security, later phase): replace with a least-privilege MinIO service account.
MINIO_ROOT_USER=change_me_minio_root_user
MINIO_ROOT_PASSWORD=change-me-minio-root-password

# --- AI service -------------------------------------------------------------------
# Required. http(s) URL of the FastAPI inference service.
AI_SERVICE_URL=http://localhost:8000
# Optional; defaults to 10000 (ms).
AI_SERVICE_TIMEOUT_MS=10000
